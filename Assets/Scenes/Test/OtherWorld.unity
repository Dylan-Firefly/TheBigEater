  storyText: "\u5F53\u7136\u53EF\u4EE5\u5566\u3002\u9E21\u86CB\uFF0C\u8C46\u5E72\uFF0C\u9999\u83C7\uFF0C\u867E\u7C73\uFF0C\u4E94\u82B1\u8089\u3002{wc}\n\u8C46\u5E72\u53EF\u4EE5\u53BB\u95EE\u95EE\u9648\u5B88\u7530\u9648\u7237\u7237\uFF0C\u4F60\u8FD8\u8BA4\u5F97\u4ED6\u5427\uFF1F{wc}\n\u4ED6\u4E00\u822C\u5C31\u5728\u6751\u5934\u6563\u6B65\uFF0C\u53BB\u627E\u627E\u4ED6\u987A\u4FBF\u6563\u6563\u5FC3\u5427\uFF01{wc}\n\u59D1\u5A18\u957F\u5927\u4E86\uFF0C\u4F1A\u987E\u5BB6\u4E86\u3002\r\n\r\r\r\r\r"
